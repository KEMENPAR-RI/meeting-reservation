DATABASE_URL=""
# Direct (unpooled) connection for migrations; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=""

ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
# Office-only access: comma-separated IPs/CIDRs (v4 and v6). Empty or invalid = deny everyone.
# Prefixes wider than IPv4 /16 or IPv6 /32 are rejected (whole list invalid, everyone denied).
OFFICE_ALLOWED_IPS=""
# On Vercel keep x-real-ip (Vercel overwrites it with the client IP). Do not put a proxy/CDN in front of Vercel.
TRUSTED_IP_HEADER="x-real-ip"
# true (default) = office IPs only; false = disable the IP check everywhere, production included.
OFFICE_IP_CHECK=true
