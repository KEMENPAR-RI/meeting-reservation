# MySQL Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_name
DB_USERNAME=root
DB_PASSWORD=

COMPOSE_FILE=docker-compose.yml:docker-compose.hostnet.yml

# Optional, Docker only: compose overrides DB_HOST with this (default host.docker.internal).
DOCKER_DB_HOST=""

# Auth
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""

# Office-only access: comma-separated IPs/CIDRs (v4 and v6). Empty or invalid = deny everyone.
# Prefixes wider than IPv4 /16 or IPv6 /32 are rejected (whole list invalid, everyone denied).
OFFICE_IP_CHECK=false
OFFICE_ALLOWED_IPS=""
TRUSTED_IP_HEADER="x-real-ip"

# Optional: public attendance submits per IP (outside office) per window. Invalid = defaults (5 per 10 min).
PUBLIC_ATTENDANCE_RATE_MAX=5
PUBLIC_ATTENDANCE_RATE_WINDOW_MIN=10

# Optional: max attendees per meeting accepted via public (outside office) submits. Invalid = 200.
PUBLIC_ATTENDANCE_MAX_PER_BOOKING=200
