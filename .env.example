DATABASE_URL=""

ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
# Office-only access: comma-separated IPs/CIDRs (v4 and v6). Empty or invalid = deny everyone.
# Prefixes wider than IPv4 /16 or IPv6 /32 are rejected (whole list invalid, everyone denied).
OFFICE_ALLOWED_IPS=""
# Keep x-real-ip, overwritten by nginx. Behind Cloudflare use nginx realip with CF ranges only; never trust a client-sendable header.
TRUSTED_IP_HEADER="x-real-ip"
# Dev only: "off" skips the check; ignored in production.
OFFICE_IP_CHECK=""
