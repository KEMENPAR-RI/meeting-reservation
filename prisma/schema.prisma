generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// CHECK constraint and the booking_locks seed row live in the init migration SQL.
model Booking {
  id              String   @id @default(uuid()) @db.Char(36)
  startsAt        DateTime @map("starts_at") @db.DateTime(6)
  endsAt          DateTime @map("ends_at") @db.DateTime(6)
  bookerName      String   @map("booker_name") @db.VarChar(100)
  division        String   @db.VarChar(100)
  agenda          String   @db.VarChar(1000)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(6)
  // ascii_bin collation lives in the migration SQL.
  attendanceToken String?  @unique @map("attendance_token") @db.Char(32)

  attendances Attendance[]

  @@index([startsAt])
  @@index([endsAt])
  @@map("bookings")
}

// nameKey = lowercased normalized name, set by the app; its utf8mb4_bin collation (not expressible in Prisma) lives in the migration SQL.
model Attendance {
  id        String   @id @default(uuid()) @db.Char(36)
  bookingId String   @map("booking_id") @db.Char(36)
  name      String   @map("attendee_name") @db.VarChar(100)
  nameKey   String   @map("name_key") @db.VarChar(150)
  division  String   @db.VarChar(100)
  // role/phone use ascii_bin collation in the migration SQL; phone is normalized to 628xxx by the app.
  role      String?  @map("attendee_role") @db.VarChar(20)
  phone     String?  @db.VarChar(16)
  signature String   @db.VarChar(100)
  signedAt  DateTime @default(now()) @map("signed_at") @db.DateTime(6)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, nameKey])
  @@unique([bookingId, phone])
  @@map("attendances")
}

// Fixed-window hit counter for public attendance submits; ip_key collation (ascii_bin) lives in the migration SQL.
model AttendanceRateLimit {
  ipKey       String   @map("ip_key") @db.VarChar(40)
  windowStart DateTime @map("window_start") @db.DateTime(0)
  hits        Int      @default(0) @db.UnsignedInt

  @@id([ipKey, windowStart])
  @@index([windowStart])
  @@map("attendance_rate_limits")
}

// Single row (id = 1) locked FOR UPDATE to serialize booking time writes (ADR 0001).
model BookingLock {
  id Int @id @db.TinyInt

  @@map("booking_locks")
}
